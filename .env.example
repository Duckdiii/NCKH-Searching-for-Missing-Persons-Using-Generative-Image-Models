# Cấu hình mẫu — KHÔNG chứa secret. Copy thành .env rồi điền giá trị thật.
# Không commit file .env. Xem docs/face-media-implementation-tasks.md (T01).

# Supabase Postgres (Transaction pooler, bắt buộc SSL).
# Ví dụ dạng: postgresql://postgres.<ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Database test RIÊNG (bắt buộc khác DATABASE_URL production).
# Fixture test dùng biến này; runner từ chối khi trùng production.
DATABASE_URL_TEST=

# Pool cho worker FastAPI (mặc định 10).
DATABASE_POOL_SIZE=10

# Lớp lưu file (T03): local | supabase
STORAGE_BACKEND=local
# Thư mục gốc khi STORAGE_BACKEND=local (key tương đối nằm dưới thư mục này).
MEDIA_ROOT=outputs/media

# Khi STORAGE_BACKEND=supabase: bucket phải private; dùng backend service/secret key.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=face-media
# SIGNED_URL_TTL_SECONDS=3600

# T09 camera: tên biến môi trường giữ URL từng camera (không lưu URL vào DB).
# Ví dụ: CAMERA_PORCH_URL=rtsp://user:pass@192.168.1.10/stream
# CAMERA_SAVE_SESSION_VIDEO bị BỎ QUA trên đường camera crop-only (P0: không ghi
# video/frame toàn khung của luồng này; xem docs/kien-truc-da-camera-tiet-kiem-bo-nho.md).
# Tự liên kết tracklet → global ID sau persist (best-effort, tắt khi chỉ muốn lưu crop).
CAMERA_AUTO_LINK=true
# Spool khi DB/storage lỗi: chỉ crop đã chọn + metadata (không spool frame/video).
CAMERA_SPOOL_DIR=outputs/spool
CAMERA_SPOOL_MAX_BYTES=536870912
CAMERA_SPOOL_TTL_SEC=3600
CAMERA_SPOOL_REDRIVE=3

# P2 liên kết ID: NGƯỠNG CHƯA HIỆU CHUẨN — chạy scripts/calibrate_link.py trên
# cặp embedding thật rồi mới điền số. Không dùng cố định 0.7/0.9.
# LINK_ACCEPT_THRESHOLD=0.55
# LINK_MARGIN=0.05
# LINK_EXEMPLAR_MIN=0.65
# LINK_TIME_WINDOW_SEC=3600
# LINK_MAX_CANDIDATES=50

# P3 gallery: rebuild batch + watermark; delta RAM cap + TTL (TTL RAM khác TTL lưu bền).
GALLERY_REBUILD_BATCH=2000
GALLERY_MAX_DELTA=5000
GALLERY_DELTA_TTL_SEC=1800
# Worker outbox nền mỗi N giây (0 = tắt, dùng POST /api/index/drain tay).
INDEX_DRAIN_INTERVAL_SEC=30

# P4 retention/GC/quota (ngưỡng thử nghiệm — đo rồi chỉnh; xem docs §9).
# Cap byte media: cảnh báo 80%, từ chối nhận thêm 90%.
# MEDIA_CAP_BYTES=
# Thumbnail đọc theo yêu cầu: cache RAM giới hạn (không lưu bản phụ).
THUMB_CACHE_BYTES=33554432
THUMB_TTL_SEC=300
# Shard key crop camera theo camera/ngày (dữ liệu mới; dữ liệu cũ giữ nguyên).
SEARCH_SHARD_BY_CAMERA_DAY=true

# GPU chung camera inference + diffusion (P3/FADING §3): VRAM còn dưới ngưỡng
# trong khi camera live → diffusion nhận 409 ưu tiên camera. Xếp chờ thay vì
# 409 ngay: DIFFUSION_QUEUE_ON_BUSY=true.
GPU_MIN_FREE_MB=1536
GPU_MIN_FREE_RATIO=0.15
DIFFUSION_QUEUE_ON_BUSY=false
DIFFUSION_QUEUE_TIMEOUT_SEC=300

# T12 quyền truy cập: để trống = local một người (không guard).
# Đặt giá trị để yêu cầu header X-API-Key trên mọi /api/* (trừ /api/health).
# FACE_MEDIA_API_KEY=

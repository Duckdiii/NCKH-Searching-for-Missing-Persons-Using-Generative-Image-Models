# Cấu hình mẫu — KHÔNG chứa secret. Copy thành .env rồi điền giá trị thật.
# Không commit file .env. Xem docs/face-media-implementation-tasks.md (T01).

# Supabase Postgres (Transaction pooler, bắt buộc SSL).
# Ví dụ dạng: postgresql://postgres.<ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Database test RIÊNG (bắt buộc khác DATABASE_URL production).
# Fixture test dùng biến này; runner từ chối khi trùng production.
DATABASE_URL_TEST=

# Pool cho worker FastAPI (mặc định 10).
DATABASE_POOL_SIZE=10

# Lớp lưu file (T03): local | supabase
STORAGE_BACKEND=local
# Thư mục gốc khi STORAGE_BACKEND=local (key tương đối nằm dưới thư mục này).
MEDIA_ROOT=outputs/media

# Khi STORAGE_BACKEND=supabase (bucket private tạo riêng qua infra, không tạo trong task này):
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=face-media
# SIGNED_URL_TTL_SECONDS=3600

# T09 camera: tên biến môi trường giữ URL từng camera (không lưu URL vào DB).
# Ví dụ: CAMERA_PORCH_URL=rtsp://user:pass@192.168.1.10/stream
# CAMERA_SAVE_SESSION_VIDEO=false — chính sách lưu video toàn phiên (mặc định tắt).

# T12 quyền truy cập: để trống = local một người (không guard).
# Đặt giá trị để yêu cầu header X-API-Key trên mọi /api/* (trừ /api/health).
# FACE_MEDIA_API_KEY=
